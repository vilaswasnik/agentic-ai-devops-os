# AWS Configuration for Bedrock
# Replace these with your actual AWS credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# LLM Configuration
# Set to 'aws' to use AWS Bedrock, 'openai' for OpenAI
LLM_PROVIDER=aws

# Optional: OpenAI Configuration (if using OpenAI instead of AWS)
# OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
# CRITICAL: Change these in production!
JWT_SECRET=your_secure_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Admin User Configuration
# REQUIRED: the server has no default admin password - set your own strong one.
ADMIN_PASSWORD=your-strong-admin-password

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Ansible Lab Configuration
ANSIBLE_LAB_USER=test_user
ANSIBLE_LAB_PASS=test_user
ANSIBLE_LAB_IMAGE=quay.io/ansible/ansible-runner:latest
ANSIBLE_LAB_NAME=ansible-lab-agent

# Security Note: NEVER commit real credentials to version control!
# Copy this file to .env and replace with your actual values.
# Use strong, randomly generated values for JWT_SECRET and ADMIN_PASSWORD!